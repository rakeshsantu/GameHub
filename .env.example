# Copy this file to .env and fill in your values
# VITE_ prefix exposes variables to the React frontend via import.meta.env

# URL to your deployed /api folder (no trailing slash)
# Examples:
#   Local dev with PHP server:  http://localhost:8080/api
#   Hostinger production:       https://yourdomain.com/api
VITE_API_URL=https://yourdomain.com/api
